# Puerto interno (el proxy Nginx lo mapea a 80/443 externamente)
APP_PORT=8080
# Redes Docker externas: la del proxy y la de la base de aberturas
PROXY_NETWORK=proxy
DB_NETWORK=aberturas_default
# Password del rol web_catalogo (ALTER ROLE web_catalogo LOGIN PASSWORD '...')
WEB_CATALOGO_DB_PASS=CAMBIA_ESTO
# Carpeta de uploads del CRM de aberturas (se monta en solo lectura)
ABERTURAS_UPLOADS=../aberturas/uploads
